# ─────────────────────────────────────────────────────────────────
#  Lumilex — Environment Variables
#  Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────


# ── Platform base URL ───────────────────────────────────────────
# Absolute links in outbound email and push notifications. Required —
# there is no default, because no default can be right for a second tenant.
APP_BASE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Anthropic AI ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Sync / cron auth ──────────────────────────────────────────────
# Shared secret for cron-gated endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=

# ── Resend (transactional email) ──────────────────────────────────
# The API key is the platform's; the From address is per firm
# (firms.settings.email.fromAddress).
RESEND_API_KEY=re_...

# ── Microsoft Graph (Outlook + SharePoint) ────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_DRIVE_USER=
MS_SHAREPOINT_SITE_HOSTNAME=yourtenant.sharepoint.com
MS_SHAREPOINT_SITE_PATH=/sites/YourSite
MS_SHAREPOINT_BASE_FOLDER=

# ── Voyage AI (embeddings) ────────────────────────────────────────
VOYAGE_API_KEY=

# ── Firecrawl ─────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ── Integration credential sealing ────────────────────────────────
# AES-256-GCM key for the bring-your-own integration credentials stored in
# firm_integrations.credentials_enc. Required — the app refuses to boot
# without it, so a firm's credentials can never land in a plaintext column
# because the key happened to be missing. 32 bytes, base64 or hex.
# Generate with: openssl rand -base64 32
# Rotating it invalidates every sealed blob: re-seal before swapping.
INTEGRATION_CREDS_KEY=

# ── Source code link ──────────────────────────────────────────────
# Lumilex is AGPL-3.0: the app links every signed-in surface to its source.
# Leave blank for the upstream repository. Running a modified copy for
# other people? Point this at your own repository (lib/source.ts).
NEXT_PUBLIC_SOURCE_URL=
